.venv/
*.o
__pycache__/
*.egg-info/
.pytest_cache/
.coverage

# A daemon-thread test writes this from a thread that can outlive the
# monkeypatched chdir, so it sometimes lands here instead of in tmp_path.
daemon-ran.txt

# SQLite sidecars a reader leaves beside a fixture .db.
*.db-shm
*.db-wal

# Cargo build trees and Node installs. `rust/.gitignore` and
# `typescript/.gitignore` say the same thing, and git honors those. The
# sdist builder reads only this file. A probe `target/` holds absolute
# symlinks, which pip refuses to unpack, so the pattern has to be here.
target/
node_modules/
