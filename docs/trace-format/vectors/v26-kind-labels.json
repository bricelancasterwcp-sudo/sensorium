  "questions": [
    {
      "id": "tree-labels-every-kind-in-javascript-s-words",
      "ask": "What marker does `tree` print for a `coroutine`, a `generator` and an `async_generator` frame on a TypeScript trace?",
      "command": ["tree", "$RUN"],
      "expect_exit": 0,
      "expect_line": [["f2", "loadTile", "[async]"],
                      ["f3", "walkTiles", "[generator]"],
                      ["f4", "streamTiles", "[async generator]"]],
      "expect_count": {"[coroutine]": 0, "[async_generator]": 0},
      "expect_absent": ["asyncio", "cargo", "python ?"]
    },
    {
      "id": "frame-labels-a-coroutine-the-same-way-tree-does",
      "ask": "Does `frame` print the same marker `tree` does for one frame, or does one view keep the contract's spelling?",
      "command": ["frame", "$RUN", "--fn", "loadTile"],
      "expect_exit": 0,
      "expect_line": [["f2", "loadTile", "[async]"]],
      "expect_absent": ["[coroutine]", "asyncio", "cargo"]
    },
    {
      "id": "frame-labels-an-async-generator-the-same-way-tree-does",
      "ask": "And the two-word label -- does `frame` print `[async generator]` where `tree` does?",
      "command": ["frame", "$RUN", "--fn", "streamTiles"],
      "expect_exit": 0,
      "expect_line": [["f4", "streamTiles", "[async generator]"]],
      "expect_absent": ["[async_generator]", "[coroutine]", "asyncio"]
    },
    {
      "id": "tree-names-no-site-for-a-suspension-that-recorded-none",
      "ask": "A frame parked at an `await` whose YIELD carries no line -- what does `tree` say about where it stopped?",
      "command": ["tree", "$RUN"],
      "expect_exit": 0,
      "expect_line": [["f5", "parkTile", "[async]", "~ suspended at end of recording"]],
      "expect_absent": ["LNone", "suspended at L"]
    },
    {
      "id": "frame-names-no-site-for-that-suspension-either",
      "ask": "And `frame` on the same parked frame -- does its `state:` segment name a line the recording does not hold?",
      "command": ["frame", "$RUN", "--fn", "parkTile"],
      "expect_exit": 0,
      "expect_line": [["f5", "parkTile", "[async]", "closed: open", "state: suspended"]],
      "expect_absent": ["state: suspended at L"]
    }
  ]
