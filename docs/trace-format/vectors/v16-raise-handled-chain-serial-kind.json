 "questions": [
   {"id": "an-err-raise-names-its-own-type",
    "ask": "How does a RAISE carrying an `Err` value render -- as that error's own type and Debug text at the `?` site's line, or as something a panic-shaped reader invented?",
    "command": ["grep", "$RUN", "RAISE"],
    "expect_exit": 0,
    "expect_line": [["e3 RAISE", "read_config raise demo::ConfigError('Missing(\"port\")') L14"]],
    "expect_count": {"matches: 1": 1},
    "expect_absent": ["panic(", "<message unreadable"]},
   {"id": "the-sink-that-absorbed-it-is-a-handled-at-its-own-line",
    "ask": "Does the `.ok()` that absorbed the chain render as a HANDLED against the frame it fired in, at the SINK's line rather than the enclosing fn's?",
    "command": ["grep", "$RUN", "HANDLED"],
    "expect_exit": 0,
    "expect_line": [["e5 HANDLED", "load handled demo::ConfigError('Missing(\"port\")') L31"]],
    "expect_count": {"matches: 1": 1},
    "expect_absent": ["L30"]},
   {"id": "a-raised-err-is-still-a-returned-frame",
    "ask": "A frame that recorded a RAISE and then returned its `Err` ended by RETURNING, not by unwinding. Does `tree` say so?",
    "command": ["tree", "$RUN"],
    "expect_exit": 0,
    "expect_line": [["f1 e1", "load()", "-> None"],
                    ["f2 e2", "read_config()", "-> Err(Missing(\"port\"))"]],
    "expect_absent": ["!! ", "(open)"]},
   {"id": "a-handled-changes-nothing-about-how-its-frame-closed",
    "ask": "Does `frame` on the frame whose sink absorbed the error report an ordinary return, with the HANDLED row changing nothing about the closing?",
    "command": ["frame", "$RUN", "--fn", "load"],
    "expect_exit": 0,
    "expect_line": [["f1 lib.rs:load", "closed: return"]],
    "expect_contains": ["return: None", "children (1):",
                        "f2 e2 read_config()"],
    "expect_absent": ["unwound:", "closed: open"]}]}
