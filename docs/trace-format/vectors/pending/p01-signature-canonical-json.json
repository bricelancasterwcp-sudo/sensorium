  "questions": [
    {
      "id": "signature-json-shape-and-msg-excluded",
      "ask": "run called helper, which raised TypeError('bad') and unwound both frames with no RETURN: does signature --json report basis signature-v1, outcome raised, fork.qualname helper (file-local, as code_objects.qualname is), disposition PROPAGATED, and omit exc.msg entirely?",
      "command": [
        "signature",
        "$RUN",
        "--json"
      ],
      "expect_exit": 0,
      "expect_line": [
        [
          "\"basis\": \"signature-v1\""
        ],
        [
          "\"outcome\": \"raised\""
        ],
        [
          "\"qualname\": \"helper\""
        ],
        [
          "\"disposition\": \"PROPAGATED\""
        ]
      ],
      "expect_absent": [
        "\"msg\""
      ]
    },
    {
      "id": "same-signature-after-file-rename-at-composition",
      "ask": "The identical frames and events, recorded under codes whose file is /w/unit_18.py instead of /w/unit_17.py but whose qualnames are unchanged: does signature --json hash to the SAME key, since qualname (not file) is what the identity is keyed on?",
