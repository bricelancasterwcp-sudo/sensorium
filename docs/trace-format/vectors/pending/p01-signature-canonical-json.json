    "run_id": "$RUN",
    "argv": [
      "prog"
    ],
    "cwd": "/w",
    "env_hash": "0000000000000000",
    "start_ts": 0.0,
    "end_ts": 1.0,
    "exit_status": 1,
    "main_thread_ident": 1,
    "fingerprint_basis": "per-task",
    "truncated_count": 0,
    "source_hashes": {},
    "recorder": "sensorium 0.8.1",
    "lang": "python",
    "capabilities": {
      "line": true,
      "locals": true,
      "return_value": true,
      "tasks": true,
      "threads": false,
      "children": false,
      "stdin": false,
      "output": false,
      "object_identity": true,
      "refocus": true
    },
    "trace_format": 4,
    "incomplete": false
  },
