    {
      "id": "margin-outside-topk-is-not-a-number",
      "ask": "Under A's distribution token 7 is outside top-2: is the margin printed as '> topk-floor' and under B's as 0.10?",
      "command": [
        "diff",
        "$RUN",
        "$RUN2"
