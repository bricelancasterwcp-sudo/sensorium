 "questions": [
   {"id": "the-sink-that-absorbed-it-is-the-one-shape-called-swallowed",
    "ask": "An `Err` a `.ok()` absorbed in a frame that then returned ok: does `exceptions` name it SWALLOWED, at the chain's ORIGIN, naming the sink, the event and the frame?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_line": [["e4 RAISE", "inner raise demo::Boom('Boom(7)') L18"],
                    ["SWALLOWED -- absorbed by sink_ok at e6 (swallow L12) in f2, which returned ok"],
                    ["hops: e4 inner L18 exit -> e6 swallow L12 sink_ok"]],
    "expect_count": {"SWALLOWED": 1, "raised (2):": 1},
    "expect_absent": ["born outside this thread's instrumented frames",
                      "ambiguous", "propagated --"]},
   {"id": "a-test-fn-that-returned-err-went-back-to-the-harness",
    "ask": "A chain that crossed two frames by `?` and left a `#[test]` fn: is it reported once, with every hop, and with the mark read from the site table?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_line": [["e9 RAISE", "inner raise demo::Boom('Boom(9)') L18"],
                    ["returned to the harness -- it left f1 (run), which the manifest marks as a #[test] fn"],
                    ["hops: e9 inner L18 exit -> e11 run L6 try -> e12 run L3 exit"]],
    "expect_contains": ["dispositions: swallowed 1, returned-to-harness 1"],
    "expect_count": {"e9 RAISE": 1}},
   {"id": "an-unreachable-try-site-qualifies-the-whole-answer",
    "ask": "A `?` the transformer could not reach records nothing. Does `exceptions` say so before the answer, naming the site, rather than letting its silence read as `nothing happened there`?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_contains": [
      "partial: 1 ?-site the transformer could not reach -- an Err raised at one is recorded by nothing and appears nowhere below",
      "run demo/src/lib.rs:7 (macro-arg)"]},
   {"id": "info-counts-the-sites-the-transformer-could-not-reach",
    "ask": "Does `info` report the partial `?` sites in the house style, as a count with what they are?",
    "command": ["info", "$RUN"],
    "expect_exit": 0,
    "expect_contains": ["partial fns: 1 (?-sites the transformer could not reach)"]},
   {"id": "a-clipped-page-never-clips-the-tally",
    "ask": "With `--limit 1`, is the tally still counted over every chain in scope, and does the continuation line name the next page?",
    "command": ["exceptions", "$RUN", "--limit", "1"],
    "expect_exit": 0,
    "expect_contains": ["dispositions: swallowed 1, returned-to-harness 1"],
    "expect_line": [["... 1 more; continue with: sensorium exceptions",
                     "--after e4 --limit 1"]],
    "expect_absent": ["e9 RAISE"]}]}
