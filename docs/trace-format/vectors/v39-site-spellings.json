      "expect_absent": ["SATISFIED", "src.lib.cache"]
    },
    {
      "id": "refuses-a-member-name-without-its-owner",
      "ask": "Does the bare member name select the method? It must not: a qualname is matched from its start.",
      "command": ["watch", "$RUN", "--at", "compute", "--expr", "n == 1"],
      "expect_exit": 1,
      "expect_contains": ["error: no recorded code matches --at 'compute'",
                          "  src/lib/cache.ts:Fog.compute"],
      "expect_absent": ["SATISFIED", "src.lib.cache"]
    },
    {
      "id": "refuses-a-directory",
      "ask": "Does a directory name select a file inside it? It must not: the file half of a spec names a FILE.",
      "command": ["watch", "$RUN", "--at", "lib:Fog", "--expr", "n == 1"],
      "expect_exit": 1,
      "expect_contains": ["error: no recorded code matches --at 'lib:Fog'",
                          "  src/lib/cache.ts:Fog.compute"],
      "expect_absent": ["SATISFIED", "src.lib.cache"]
    },
    {
      "id": "refuses-a-path-this-trace-does-not-hold",
      "ask": "Does a root-relative path that is nearly right select the file? It must not -- answering about `src/lib/cache.ts` would answer about code the reader did not name.",
      "command": ["watch", "$RUN", "--at", "src/cache.ts:Fog", "--expr",
                  "n == 1"],
      "expect_exit": 1,
      "expect_contains": [
        "error: no recorded code matches --at 'src/cache.ts:Fog'",
        "  src/lib/cache.ts:Fog.compute"],
      "expect_absent": ["SATISFIED", "src.lib.cache"]
    },
    {
      "id": "refuses-a-qualname-with-a-further-segment",
      "ask": "Does a spec naming something INSIDE the method select the method?",
      "command": ["watch", "$RUN", "--at", "Fog.compute.x", "--expr",
                  "n == 1"],
      "expect_exit": 1,
      "expect_contains": [
        "error: no recorded code matches --at 'Fog.compute.x'",
