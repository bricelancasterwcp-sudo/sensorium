                  "n == 1"],
      "expect_exit": 0,
      "expect_line": [["verdict: SATISFIED at 1 of the 1 site(s)"]]
    },
    {
      "id": "matches-the-root-relative-path",
      "ask": "Does the path relative to the invocation's root select it -- the form `info` prints and `--focus` resolves?",
