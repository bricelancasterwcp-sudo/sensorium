 "questions": [
   {"id": "a-chain-that-left-its-thread-is-ambiguous-never-a-swallow",
    "ask": "The chain's last event carries `chain.terminal: \"left_thread\"`. Does `exceptions` report AMBIGUOUS, name the JoinHandle, and say what the recording cannot settle -- with no accusation anywhere?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_count": {"ambiguous -- it left its thread into a JoinHandle; whether it was ever read is not recorded": 1,
                     "the parent may have unwrapped it, logged it or dropped the handle; a spawned thread's return value leaves no record of being read": 1,
                     "dispositions: ambiguous 1": 1},
    "expect_absent": ["SWALLOWED", "swallowed ", "panicked", "propagated",
                      "returned to the harness"]},
   {"id": "two-hops-are-one-chain-reported-once",
    "ask": "The Err crossed `inner` and then `worker` under one serial. Is it reported ONCE, at its origin, with both hops on the journey line?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_line": [["e4 RAISE", "inner raise demo::Boom('Boom(7)') L18"]],
    "expect_count": {"raised (1):": 1,
                     "hops: e4 inner L18 exit -> e6 worker L40 exit": 1},
    "expect_absent": ["e6 RAISE  worker raise"]},
   {"id": "a-spawned-threads-stream-is-a-task-row-not-a-thread-row",
    "ask": "A Rust trace carries one `fingerprints` row -- the main thread's -- and every other thread as a named task. Does `info` read this trace that way?",
    "command": ["info", "$RUN"],
    "expect_exit": 0,
    "expect_contains": ["tasks: 1 (t2 spawns :: spawn@spawns#1)",
                        "threads started: 1 besides the main one"],
    "expect_line": [["fingerprint thread 1 (main)", "2 causal events outside any test or spawned thread"]],
    "expect_absent": ["fingerprint thread 2", "asyncio"]}]}
