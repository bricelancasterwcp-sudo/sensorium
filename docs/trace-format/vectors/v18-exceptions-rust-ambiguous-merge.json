 "questions": [
   {"id": "two-errs-in-one-window-are-never-a-swallow",
    "ask": "Two different `Err`s shared one frame's window. Does `exceptions` report both as ambiguous, saying why the window cannot be split, and accuse neither?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_line": [["e3 RAISE", "inner raise demo::First('First') L14"],
                    ["e5 RAISE", "outer raise demo::Second('Second') L33"]],
    "expect_count": {"ambiguous -- it shared a frame's window with another, different Err": 2,
                     "raised (3):": 1},
    "expect_absent": ["SWALLOWED", "swallowed "]},
   {"id": "a-bound-and-escaped-arm-is-ambiguous",
    "ask": "An `Err(e) =>` arm bound the error and let the name escape. Is that ambiguous, with the reason named, rather than a swallow?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_contains": [
      "ambiguous -- an Err(..) arm at e11 (collect L43) bound it to a name and let the name escape",
      "a bound error that is stored, returned or logged is not a swallow",
      "hops: e9 inner L14 exit -> e11 collect L43 arm_ambiguous"],
    "expect_absent": ["SWALLOWED"]},
   {"id": "the-tally-names-only-the-dispositions-that-happened",
    "ask": "Does the tally print in the fixed order, listing only the dispositions this run produced?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_count": {"dispositions: ambiguous 3": 1},
    "expect_absent": ["dispositions: ambiguous 3, ", "panicked", "propagated",
                      "partial: "]},
   {"id": "zero-partial-sites-is-a-finding-and-is-printed",
    "ask": "The transformer reached every `?` site in this unit. Does `info` print the zero -- the count IS the claim -- while `exceptions` prints no header, having nothing to qualify?",
    "command": ["info", "$RUN"],
    "expect_exit": 0,
    "expect_contains": ["partial fns: 0 (?-sites the transformer could not reach)"]}]}
