 "questions": [
   {"id": "the-verdict-quotes-the-unwind-and-claims-no-cause",
    "ask": "A chain whose last event carries `chain.terminal: \"panicked\"`. Does `exceptions` report PANICKED, quote the panic the holder frame unwound with, and say explicitly that this is not a claim the Err caused it?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_line": [["e3 RAISE", "inner raise demo::Boom('Boom(7)') L18"]],
    "expect_count": {"panicked -- the frame holding it unwound (f1, panic('called `Result::unwrap()` on an `Err` value: Boom(7)'))": 1,
                     "the trace says f1 unwound while holding this Err, not that the Err caused the panic": 1,
                     "dispositions: panicked 1": 1},
    "expect_absent": ["SWALLOWED", "swallowed ", "ambiguous"]},
   {"id": "the-holder-is-the-innermost-unwound-ancestor-not-the-events-frame",
    "ask": "The chain's last event fired in `inner` (f2), which RETURNED err; `run` (f1) is the frame that unwound. Which frame does the verdict name?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_contains": ["unwound (f1, panic("],
    "expect_absent": ["unwound (f2,", "no unwound frame is recorded"]},
   {"id": "a-panicked-chain-needs-no-panic-EVENT",
    "ask": "This recording holds no panic RAISE at all -- the unwind is the frame's own `closed_by`/`unwind_exc`. Does the disposition still stand, with no panic tally printed?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_count": {"raised (1):": 1},
    "expect_absent": ["panics: ", "no exceptions recorded"]},
   {"id": "the-same-evidence-renders-as-an-unwind-in-tree",
    "ask": "Does `tree` show f1 ending on that panic rather than left open, so the verdict and the render read one fact?",
    "command": ["tree", "$RUN"],
    "expect_exit": 0,
    "expect_line": [["f1 e1", "run()", "!! panic('called `Result::unwrap()` on an `Err` value: Boom(7)')"],
                    ["f2 e2", "inner()", "-> Err(Boom(7))"]],
    "expect_absent": ["(open)", "[None]"]}]}
