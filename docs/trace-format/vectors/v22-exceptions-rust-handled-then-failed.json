 "questions": [
   {"id": "a-sink-whose-frame-then-failed-is-never-a-swallow",
    "ask": "A written sink absorbed the Err and the frame holding it then failed for another reason. Is that AMBIGUOUS, with the blind spot named, rather than the one accusation this command makes?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_line": [["e2 HANDLED", "run handled std::io::Error('NotFound') L5"]],
    "expect_count": {"ambiguous -- absorbed by sink_let_underscore at e2 (run L5) in f1, but f1 then failed anyway": 1,
                     "handled, then the frame failed for another reason -- the cleanup-then-fail blind spot (design R8): a genuine swallow in a frame that later fails reads ambiguous, not a swallow": 1},
    "expect_absent": ["SWALLOWED", "swallowed "]},
   {"id": "the-err-that-left-the-frame-is-a-chain-of-its-own",
    "ask": "One frame, two Errs, two serials. Are they reported as two chains with their own terminals, rather than merged into the sink's verdict?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_line": [["e3 RAISE", "run raise demo::Boom('Boom(7)') L3"],
                    ["returned to the harness -- it left f1 (run), which the manifest marks as a #[test] fn"]],
    "expect_count": {"raised (2):": 1},
    "expect_absent": ["it shared a frame's window with another, different Err"]},
   {"id": "the-tally-prints-in-the-fixed-order",
    "ask": "The chains were encountered ambiguous-first. Does the tally still print in the fixed order `swallowed, panicked, returned-to-harness, propagated, ambiguous`, naming only what happened?",
    "command": ["exceptions", "$RUN"],
    "expect_exit": 0,
    "expect_count": {"dispositions: returned-to-harness 1, ambiguous 1": 1},
    "expect_absent": ["dispositions: ambiguous 1, returned-to-harness 1",
                      "panicked", "propagated", "partial: "]}]}
