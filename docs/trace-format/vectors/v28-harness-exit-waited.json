{
  "id": "v28-harness-exit-waited",
  "asserts": "Three exit facts live on one TypeScript trace and none of them ever wears another's name (`typescript/HONESTY.md` §6). The CONTAINER's own status is `exit_status: null` / `exit_status_basis: \"unwitnessed\"`: the driver spawned the harness, not the worker, so nobody reaped this process. What the container SAID about its own ending before it went is `exit_self_reported`, which nobody waited for either and which is printed saying so. What the driver actually waited for is `harness_exit {status, signal, basis: \"waited\"}`, printed on `info`'s harness line and in `runs`' invocation header. `runs` prints `exit:unwitnessed` on the member and `exit:1 (waited)` on the header of the same invocation, in one listing, because they are two different facts about two different processes.",
  "meta": {
    "trace_format": 4,
    "run_id": "$RUN",
    "argv": ["/usr/bin/node", "/w/app/node_modules/vitest/dist/workers/forks.js"],
    "cwd": "/w/app",
    "env_hash": "0000000000000000",
    "start_ts": 0.0,
    "end_ts": 1.0,
    "exit_status": null,
    "exit_status_basis": "unwitnessed",
    "main_thread_ident": 1,
    "fingerprint_basis": "per-task",
    "truncated_count": 0,
    "source_hashes": {"src/fail.test.ts": "eeeeeeeeeeeeeeee"},
    "recorder": "sensorium-ts 0.1.0",
    "lang": "typescript",
    "capabilities": {"line": false, "locals": false, "return_value": true,
                     "tasks": true, "threads": false, "children": false,
                     "stdin": false, "output": false,
                     "object_identity": false, "refocus": false,
                     "err_flow": false},
    "caps": {"dbg": 200, "depth": 2, "sample": 8, "str": 100},
    "invocation": "20260101-000000-111111",
    "harness": "vitest",
    "harness_args": ["run", "src/fail.test.ts"],
    "harness_exit": {"status": 1, "signal": null, "basis": "waited"},
    "driver_version": "0.1.0",
    "node": "v24.16.0",
    "vitest": "4.1.9",
    "environment": "node",
    "wire": 1,
    "pid": 4246,
    "ppid": 4241,
    "thread_id_os": 3,
    "is_main_thread": false,
    "test_file": "src/fail.test.ts",
    "exit_self_reported": {"code": 1, "signal": null},
    "tests_seen": 1,
    "task_name_basis": "vitest",
    "task_name_conflicts": 0,
    "files_transformed": 2,
    "transform_excluded": {},
    "unhandled_rejections": [],
    "throw_flow_outside_frames": 0,
    "incomplete": false
  },
  "codes": [["/w/app/src/fail.test.ts", "main", 1]],
  "frames": [
    {"parent": null, "code": 1, "call": 1, "return": 2, "depth": 0,
     "thread": 1, "closed_by": "return", "kind": "function"}
  ],
  "events": [
    {"ts": 1000, "thread": 1, "kind": "CALL", "code": 1, "line": 1,
     "payload": {"args": {}, "unread": ["locals"]}, "task": 1},
    {"ts": 2000, "thread": 1, "kind": "RETURN", "frame": 1, "code": 1,
     "line": null,
     "payload": {"outcome": "ok", "value": {"k": "dbg", "v": "undefined"}},
     "task": 1}
  ],
  "tasks": [[1, "fail > asserts a mask", 1]],
  "threads_with_rows": [1],
  "fingerprints": "compute",
  "questions": [
    {
      "id": "info-keeps-the-three-exit-facts-apart",
      "ask": "Three processes, three endings: what does `info` say the container's status was, what the container said about itself, and what the driver waited for?",
      "command": ["info", "$RUN"],
      "expect_exit": 0,
      "expect_contains": [
        "exit: unwitnessed",
        "harness: vitest run src/fail.test.ts  exit: 1 (waited)",
        "container exit: self-reported code 1 (nobody waited)",
        "container: pid 4246  thread 3 (worker)  file: src/fail.test.ts"],
      "expect_absent": ["exit: None", "asyncio", "cargo"]
    },
    {
      "id": "runs-prints-the-member-s-fact-and-the-header-s-fact",
      "ask": "In one listing, does `runs` keep the container's unwitnessed ending on the member row and the harness's waited ending on the header?",
      "command": ["runs"],
      "expect_exit": 0,
      "expect_line": [
        ["invocation 20260101-000000-111111:", "vitest run src/fail.test.ts",
         "exit:1 (waited)"],
        ["exit:unwitnessed", "events:2", "file: src/fail.test.ts"]],
      "expect_absent": ["exit:None", "cargo", "asyncio", "cmd: "]
    }
  ]
}
