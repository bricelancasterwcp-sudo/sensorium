    {
      "id": "a-focused-frame-shows-its-arguments-and-its-rows",
      "ask": "Does `frame` print the arguments a focused activation was called with, and one timeline row per instrumented statement -- the block-ending row included?",
      "command": ["frame", "$RUN", "--fn", "refresh"],
      "expect_exit": 0,
      "expect_contains": ["args: key='rate'", "timeline:",
                          "refresh L13  base=4", "refresh L15  scaled=8",
                          "refresh L17  unbound:scaled", "return: 100"],
      "expect_absent": ["unread: locals", "timeline: not captured",
                        "sensorium run --focus"]
    },
    {
      "id": "the-tree-tells-a-focused-call-from-an-unfocused-one",
      "ask": "Does the call tree show the focused call's argument and return beside a sibling whose locals were never read?",
      "command": ["tree", "$RUN"],
      "expect_exit": 0,
      "expect_contains": ["refresh(key='rate') -> 100",
                          "Fog.compute() <unread: locals> -> 7"],
      "expect_absent": ["refresh() <unread: locals>"]
    },
    {
      "id": "info-names-what-the-focus-selected",
      "ask": "Does `info` print the focus as it was typed, what it selected, and the transform's own count where the two differ?",
      "command": ["info", "$RUN"],
      "expect_exit": 0,
      "expect_line": [
        ["focus: cache.ts:refresh", "window: -"],
        ["focus matched: 1", "src/lib/cache.ts:refresh",
         "(2 function(s) focused by the transform)"],
        ["capabilities:", "line=yes", "locals=yes", "object_identity=yes"]],
