 "questions": [
   {"id": "the-blocks-own-row-names-what-died-with-it",
    "ask": "The block at L5 declares `x` at L6. Which row says `x` went out of scope, and what does it name?",
    "command": ["frame", "$RUN", "--fn", "shape"],
    "expect_exit": 0,
    "expect_line": [["LINE", "shape L6", "x=2"],
                    ["LINE", "shape L5", "unbound:x"],
                    ["LINE", "shape L9", "acc=3"]],
    "expect_count": {"unbound:": 1},
    "expect_absent": ["timeline: not captured", "unbound:x  unbound:x"]},
   {"id": "a-name-the-block-killed-reads-absent-below-that-row",
    "ask": "`x` is 2 inside the block. Does `watch` report it as a HIT there and as NOT IN SCOPE at every site below the block's own row, rather than folding the dead binding forward?",
    "command": ["watch", "$RUN", "--at", "shape", "--expr", "x == 2"],
    "expect_exit": 0,
    "expect_contains": [
      "verdict: SATISFIED at 1 of the 1 site(s) the predicate could be evaluated at",
      "x: not in scope at this site   [3 site(s)]"],
    "expect_line": [["HIT", "LINE", "shape L6", "x=2"]],
    "expect_absent": ["NEVER RECORDED"]},
   {"id": "the-shadowed-outer-binding-is-absence-and-never-a-stale-value",
    "ask": "Rust's outer `x` is alive after the block. Does the recording answer `x == 1` with a value, or does it say the name is not in scope?",
    "command": ["watch", "$RUN", "--at", "shape", "--expr", "x == 1"],
    "expect_exit": 1,
    "expect_contains": ["x: not in scope at this site   [3 site(s)]"],
    "expect_absent": ["x=1", "HIT"]}]}
