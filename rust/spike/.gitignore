/target
# Runtime artifacts. A spool or proc header inside the source tree means some
# run was inert-by-mistake and wrote to its working directory -- which is what
# the sandboxed inert tests exist to catch. Never source.
*.spool
*.proc.json
probes/ws/target/
# Task 4's end-to-end tests build into a temp CARGO_TARGET_DIR under the
# probe workspace itself (so parent(--target) is the real workspace root),
# cleaned up by the test fixture; ignored here too as a safety net for an
# interrupted run.
probes/ws/convert-e2e-target-*/
